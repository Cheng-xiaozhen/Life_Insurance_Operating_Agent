      "version": "3.0.0",
      "title": "标准组",
      "required": true,
      "query_ref": "monthly-performance.standard-team",
      "parameters": {
        "standard_team_yoy_threshold": -20,
        "standard_team_share_threshold": 30
      },
      "steps": [
        {
          "id": "standard_team_classification",
          "type": "classify",
          "display_order": "source",
          "bands": [
            {
              "id": "yoy_low",
              "metric": "standard_yoy",
              "operator": "lt",
              "threshold_param": "standard_team_yoy_threshold"
            },
            {
              "id": "share_low",
              "metric": "standard_share",
              "operator": "lt",
