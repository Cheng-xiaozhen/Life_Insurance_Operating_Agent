{
  "report_id": "monthly-performance",
  "report_version": "3.0.0",
  "title": "五月业绩分析报告",
  "parameters": {
    "report_month_name": "五月",
    "data_month_name": "5月",
    "quarter_name": "二季度",
    "cutoff_date": "5月31日"
  },
  "scenes": [
    {
      "scene_id": "standard-premium",
      "version": "3.0.0",
      "title": "标保",
      "required": true,
      "query_ref": "monthly-performance.standard-premium",
      "parameters": {
        "data_month_name": "5月",
        "cutoff_date": "5月31日",
        "monthly_high_threshold": 70,
        "monthly_target_threshold": 100,
        "monthly_low_threshold": 50,
        "monthly_very_low_threshold": 5,
        "yearly_high_threshold": 60,
        "yearly_very_high_threshold": 80,
        "yearly_low_threshold": 45
      },
      "steps": [
        {
          "id": "overall_summary",
          "type": "summarize",
          "metrics": [
            "month_amount",
            "month_rate",
            "month_yoy",
            "year_amount",
            "year_progress",
            "year_yoy"
          ]
        },
        {
          "id": "monthly_rate_classification",
          "type": "classify",
          "metric": "month_rate",
          "display_order": "source",
          "bands": [
            {
              "id": "high",
              "operator": "gt",
              "threshold_param": "monthly_high_threshold"
            },
            {
              "id": "target_met",
              "operator": "gte",
              "threshold_param": "monthly_target_threshold"
            },
            {
              "id": "low",
              "operator": "lt",
              "threshold_param": "monthly_low_threshold"
            },
            {
              "id": "very_low",
              "operator": "lt",
              "threshold_param": "monthly_very_low_threshold"
            }
          ]
        },
        {
          "id": "yearly_progress_classification",
          "type": "classify",
          "metric": "year_progress",
          "display_order": "source",
          "bands": [
            {
              "id": "high",
              "operator": "gt",
              "threshold_param": "yearly_high_threshold"
            },
            {
              "id": "very_high",
              "operator": "gt",
              "threshold_param": "yearly_very_high_threshold"
            },
            {
              "id": "low",
              "operator": "lt",
              "threshold_param": "yearly_low_threshold"
            }
          ]
        }
      ],
      "signals": {
        "target_met": {
          "from": {
            "step": "monthly_rate_classification",
            "band": "target_met"
          }
        },
        "severe_low": {
          "from": {
            "step": "monthly_rate_classification",
            "band": "very_low"
          }
        }
      },
      "expression": {
        "style_profile": "monthly-operation-report",
        "example_tags": [
          "summary",
          "threshold-classification"
        ]
      }
    },
    {
      "scene_id": "value",
      "version": "3.0.0",
      "title": "价值",
      "required": true,
      "query_ref": "monthly-performance.value",
      "parameters": {
        "data_month_name": "5月",
        "cutoff_date": "5月31日",
        "value_high_threshold": 85,
        "value_low_threshold": 55
      },
      "steps": [
        {
          "id": "overall_summary",
