    {
      "scene_id": "recruitment",
      "version": "3.0.0",
      "title": "新增",
      "required": true,
      "query_ref": "monthly-performance.recruitment",
      "parameters": {
        "data_month_name": "5月",
        "cutoff_date": "5月31日",
        "recruitment_middle_low_threshold": 80,
        "recruitment_target_threshold": 100,
        "recruitment_low_threshold": 40,
        "bachelor_target_threshold": 0,
        "bachelor_excess_threshold": 10
      },
      "steps": [
        {
          "id": "overall_summary",
          "type": "summarize",
          "metrics": [
            "training_count",
            "added_count",
            "added_rate",
            "added_yoy",
            "first_sun_count",
            "first_sun_rate",
            "college_share",
            "college_yoy",
            "bachelor_share",
            "bachelor_gap"
          ]
        },
        {
          "id": "recruitment_rate_classification",
          "type": "classify",
          "metric": "added_rate",
          "display_order": "source",
          "bands": [
            {
              "id": "middle",
              "conditions": {
                "match": "all",
                "rules": [
                  {
                    "metric": "added_rate",
                    "operator": "gt",
                    "threshold_param": "recruitment_middle_low_threshold"
                  },
                  {
                    "metric": "added_rate",
                    "operator": "lt",
                    "threshold_param": "recruitment_target_threshold"
                  }
                ]
              },
              "display_metric": "added_rate",
              "display_threshold_param": "recruitment_middle_low_threshold"
            },
            {
              "id": "target_met",
              "operator": "gte",
              "threshold_param": "recruitment_target_threshold"
            }
          ]
        },
        {
          "id": "recruitment_rate_low",
          "type": "classify",
          "metric": "added_rate",
          "display_order": "source",
          "bands": [
            {
              "id": "low",
              "operator": "lt",
              "threshold_param": "recruitment_low_threshold"
            }
          ]
        },
        {
          "id": "bachelor_classification",
          "type": "classify",
          "metric": "bachelor_gap",
          "display_order": "source",
          "bands": [
            {
              "id": "target_met",
              "operator": "gte",
              "threshold_param": "bachelor_target_threshold"
            },
            {
              "id": "excess",
              "operator": "gt",
              "threshold_param": "bachelor_excess_threshold"
            }
          ]
        },
        {
          "id": "bachelor_target_not_met",
          "type": "classify",
          "metric": "bachelor_gap",
          "display_order": "source",
          "bands": [
            {
              "id": "not_met",
              "conditions": {
                "match": "any",
                "rules": [
                  {
                    "metric": "bachelor_gap",
                    "operator": "lt",
                    "threshold_param": "bachelor_target_threshold"
                  },
                  {
                    "metric": "bachelor_gap",
                    "operator": "is_missing"
                  }
                ]
              }
            }
          ]
        }
      ],
      "signals": {
        "target_met": {
          "from": {
            "step": "recruitment_rate_classification",
            "band": "target_met"
          }
        }
      },
      "expression": {
        "style_profile": "monthly-operation-report",
        "example_tags": [
          "summary",
          "compound-condition",
          "missing-value"
        ]
      }
    },
    {
      "scene_id": "co-recruitment",
      "version": "3.0.0",
      "title": "同引",
      "required": true,
      "query_ref": "monthly-performance.co-recruitment",
      "parameters": {
        "data_month_name": "5月",
        "quarter_name": "二季度",
        "cutoff_date": "5月31日",
        "co_recruitment_target_threshold": 100,
        "co_recruitment_middle_threshold": 50,
        "zero_threshold": 0
      },
      "steps": [
        {
          "id": "overall_summary",
          "type": "summarize",
          "metrics": [
            "month_training_count",
            "month_training_yoy",
            "quarter_achieved",
            "quarter_rate",
            "quarter_yoy",
            "quarter_college_share",
            "quarter_college_yoy",
            "quarter_bachelor_share",
            "quarter_bachelor_yoy"
          ]
        },
        {
          "id": "quarter_rate_classification",
          "type": "classify",
          "metric": "quarter_rate",
          "display_order": "source",
          "bands": [
            {
              "id": "target_met",
              "operator": "gte",
              "threshold_param": "co_recruitment_target_threshold"
            },
            {
              "id": "middle",
              "conditions": {
                "match": "all",
                "rules": [
                  {
                    "metric": "quarter_rate",
                    "operator": "gte",
                    "threshold_param": "co_recruitment_middle_threshold"
                  },
                  {
                    "metric": "quarter_rate",
                    "operator": "lt",
                    "threshold_param": "co_recruitment_target_threshold"
                  }
                ]
              },
              "display_metric": "quarter_rate",
              "display_threshold_param": "co_recruitment_middle_threshold"
            }
          ]
        },
        {
          "id": "zero_classification",
          "type": "classify",
          "display_order": "source",
          "bands": [
            {
              "id": "both_zero",
              "conditions": {
                "match": "all",
                "rules": [
                  {
                    "metric": "month_training_count",
                    "operator": "eq",
                    "threshold_param": "zero_threshold"
                  },
                  {
                    "metric": "quarter_achieved",
                    "operator": "eq",
                    "threshold_param": "zero_threshold"
                  }
                ]
              },
              "display_metric": "month_training_count"
            }
          ]
        }
      ],
      "signals": {
        "target_met": {
          "from": {
            "step": "quarter_rate_classification",
            "band": "target_met"
          }
        }
      },
      "expression": {
        "style_profile": "monthly-operation-report",
        "example_tags": [
          "summary",
          "compound-condition"
        ]
      }
    }
