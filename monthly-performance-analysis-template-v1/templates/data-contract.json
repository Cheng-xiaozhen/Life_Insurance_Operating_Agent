      "fields": {
        "headcount": {
          "column": "活动人力",
          "format": "integer"
        },
        "yoy": {
          "column": "同比",
          "format": "yoy_pct_phrase"
        },
        "rate": {
          "column": "活动人力达成率",
          "format": "pct"
        }
      }
    },
    "sunshine_manpower": {
      "source": "阳光人力.csv",
      "row": "全系统",
      "fields": {
        "headcount": {
          "column": "阳光人力达成",
          "format": "integer"
        },
