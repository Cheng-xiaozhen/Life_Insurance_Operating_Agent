{
  "contract_version": "4.0.0",
  "template": "report.md.j2",
  "source_encoding": "UTF-8",
  "normalization": {
    "trim_headers": true,
    "trim_string_values": true,
    "percent_storage": "Store 61.8% as numeric 61.8.",
    "point_storage": "Store -1.1pt as numeric -1.1.",
    "missing_markers": [
      "",
      "-"
    ],
    "organization_order": "Rank by the configured metric to select organizations, then restore source CSV row order for display.",
    "total_row": "Select the row whose first column equals 全系统."
  },
  "meta": {
    "report_month_name": {
      "type": "string",
      "example": "五月",
      "description": "用于封面标题，不可从 PDF 文件名直接推断。"
    },
    "data_month_name": {
      "type": "string",
      "example": "5月",
      "description": "用于指标名称和正文。"
    },
    "cutoff_date": {
      "type": "string",
      "example": "5月31日"
    },
    "quarter_name": {
      "type": "string",
      "example": "二季度"
    }
  },
  "summary": {
    "standard_premium": {
      "source": "标保.csv",
      "row": "全系统",
      "fields": {
        "month_amount": {
          "column": "{data_month_name}达成",
          "format": "amount_wan"
        },
        "month_rate": {
          "column": "{data_month_name}达成率",
          "format": "pct"
        },
        "month_yoy": {
          "column": "{data_month_name}同比",
          "format": "yoy_pct_phrase"
        },
        "year_amount": {
          "column": "全年标保达成",
          "format": "amount_wan"
        },
        "year_progress": {
          "column": "全年进度",
          "format": "pct"
        },
        "year_yoy": {
          "column": "全年同比",
          "format": "yoy_pct_phrase"
        }
      }
    },
    "value": {
      "source": "价值.csv",
      "row": "全系统",
      "fields": {
        "month_amount": {
          "column": "{data_month_name}达成",
          "format": "amount_wan"
        },
        "month_rate": {
          "column": "{data_month_name}达成率",
          "format": "pct"
        },
        "month_yoy": {
          "column": "{data_month_name}序时同比",
          "format": "yoy_pct_phrase"
        },
        "year_progress": {
          "column": "全年进度",
          "format": "pct"
        },
        "year_yoy": {
          "column": "全年同比",
          "format": "yoy_pct_phrase"
        }
      }
    },
    "active_manpower": {
      "source": "活动人力.csv",
