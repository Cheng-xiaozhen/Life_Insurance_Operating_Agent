{
  "scenarios": [
    {
      "id": "scenario-biaobao-achievement",
      "name": "标保达成分析",
      "category": "保费分析",
      "description": "分析全系统及各机构标保达成情况，包括当月达成、同比趋势、全年进度",
      "trigger_patterns": [
        "标保达成", "标保怎么样", "标保情况", "保费达成", "保费目标",
        "达成率排名", "标保同比", "哪些机构标保"
      ],
      "analysis_steps": [
        { "step": 1, "action": "汇总全系统标保总体数据", "metrics": ["monthly_biaobao_amount", "monthly_biaobao_rate", "monthly_biaobao_yoy", "yearly_biaobao_amount", "yearly_biaobao_progress", "yearly_biaobao_yoy"] },
        { "step": 2, "action": "按达成率对机构进行排名分组", "metrics": ["monthly_biaobao_rate"], "params": { "group_thresholds": { "excellent": 70, "warning": 50 } } },
        { "step": 3, "action": "识别达成率优秀的机构（>70%）和预警机构（<50%）", "metrics": ["monthly_biaobao_rate"] },
        { "step": 4, "action": "对比全年进度，分析年度趋势", "metrics": ["yearly_biaobao_progress", "yearly_biaobao_yoy"] }
      ],
      "required_metrics": [
        "monthly_biaobao_amount", "monthly_biaobao_rate", "monthly_biaobao_yoy",
        "yearly_biaobao_amount", "yearly_biaobao_progress", "yearly_biaobao_yoy"
      ],
      "visual_suggestion": "bar_chart",
      "applied_patterns": ["pattern-benchmark-ranking", "pattern-yoy-trend", "pattern-progress-tracking"]
    },
